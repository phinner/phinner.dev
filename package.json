{
  "name": "phinner-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env dist/server/node.js",
    "check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write --unsafe .",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:http": "pnpm build && node --test tests/http.test.mjs",
    "dev:worker": "wrangler dev --local",
    "test:worker": "pnpm build && node --test tests/worker.test.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/momo-trust-display": "^5.3.0",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.18",
    "@solidjs/web": "2.0.0-rc.4",
    "effect": "4.0.0-rc.112",
    "solid-js": "2.0.0-rc.4",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "3.0.0-next.27",
    "wrangler": "^4.129.1"
  }
}
