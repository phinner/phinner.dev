{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phinner-dev",
  "main": "dist/server/worker.js",
  "compatibility_date": "2026-09-08",
  "build": {
    "command": "pnpm build",
    "watch_dir": ["src", "public", "vite.config.ts"]
  },
  "assets": {
    "directory": "dist/client"
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "keep_vars": true,
  "routes": [
    {
      "pattern": "phinner.dev",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
